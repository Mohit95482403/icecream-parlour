
# ============================================================
# GLACÉ ICE CREAM - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND (Vercel) Environment Variables
# ------------------------------------------------------------
# Set in Vercel Project Settings -> Environment Variables
VITE_API_URL=https://glace-backend.onrender.com/api

# ------------------------------------------------------------
# 2. BACKEND (Render) Environment Variables
# ------------------------------------------------------------
# Set in Render Service Dashboard -> Environment
NODE_ENV=production
PORT=5000
JWT_SECRET=generate_a_secure_random_string_here
FRONTEND_URL=https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# ------------------------------------------------------------
# 3. DATABASE (Railway Cloud MySQL for Render)
# ------------------------------------------------------------
# IMPORTANT: Render is outside Railway. In Railway, enable "Public Networking" / "TCP Proxy"
# under MySQL Service -> Settings -> Networking -> Public Networking.
# Then enter the public domain and port into Render:
DB_HOST=junction.proxy.rlwy.net
DB_PORT=12345
DB_USER=root
DB_PASSWORD=your_railway_password
DB_NAME=railway
DB_SSL=true
DB_CONNECTION_LIMIT=10
