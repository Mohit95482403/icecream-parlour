# ============================================================
# GLACÉ ICE CREAM - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND (Vercel) Environment Variables
# ------------------------------------------------------------
# URL of your deployed Render backend (ending in /api)
VITE_API_URL=https://glace-icecream-api.onrender.com/api

# ------------------------------------------------------------
# 2. BACKEND (Render) Environment Variables
# ------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Strong random secret key for JWT auth
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Frontend Origins for CORS
FRONTEND_URL=https://glace-icecream.vercel.app
CLIENT_URL=https://glace-icecream.vercel.app

# ------------------------------------------------------------
# 3. DATABASE (Cloud MySQL on Aiven / Railway / PlanetScale / etc.)
# ------------------------------------------------------------
# Option A: Connection URI
# DATABASE_URL=mysql://user:password@host:port/database_name

# Option B: Individual connection parameters
DB_HOST=your-mysql-host.cloud
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=icecream_db
DB_SSL=true
DB_CONNECTION_LIMIT=10
