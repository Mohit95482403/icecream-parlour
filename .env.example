# ============================================================
# GLACÉ ICE CREAM - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================
# This file documents ALL environment variables used by the project.
# Actual .env files go in frontend/ and backend/ respectively.
#
# Frontend variables → frontend/.env
# Backend variables  → backend/.env
#
# See frontend/.env.example and backend/.env.example for details.
# ============================================================

# ------------------------------------------------------------
# FRONTEND (Vercel) — set in frontend/.env or Vercel dashboard
# ------------------------------------------------------------
VITE_API_URL=https://your-backend.onrender.com/api

# ------------------------------------------------------------
# BACKEND (Render) — set in backend/.env or Render dashboard
# ------------------------------------------------------------
NODE_ENV=production
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here
FRONTEND_URL=https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# Database (Cloud MySQL)
DB_HOST=your-mysql-host.cloud
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=icecream_db
DB_SSL=true
DB_CONNECTION_LIMIT=10
# Or use a connection string:
# DATABASE_URL=mysql://user:password@host:port/database_name
